# Copy to terraform.tfvars (gitignored) and fill in real values before
# planning against a real AWS account. Every value below is a placeholder —
# never commit real credentials, account IDs, or passwords.

aws_region   = "us-east-1"
environment  = "dev"
project_name = "travel-hub"

# Set to false only once real credentials are supplied via the AWS
# provider's normal mechanisms (env vars, a shared credentials file, SSO) —
# never inline here.
mock_credentials = true

# Only needed for a LocalStack-backed plan (see README.md).
# localstack_endpoint = "http://localhost:4566"

aws_account_id = "123456789012" # replace with the real target account ID

availability_zones = ["us-east-1a", "us-east-1b"]

db_name     = "travel_hub"
db_username = "travel_hub_app"
# db_password has no default — set via TF_VAR_db_password or an untracked
# tfvars file, never committed.

api_container_image    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/travel-hub-bff:latest"
worker_container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/travel-hub-bff:latest"
